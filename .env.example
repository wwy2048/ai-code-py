# MySQL 使用与原项目一致的表结构
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/aicode?charset=utf8mb4

# Redis 保存服务端 Session
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# 前端开发地址
CORS_ORIGINS=["http://localhost:5173"]

# 生产环境应开启 Secure Cookie
SESSION_COOKIE_SECURE=false

# DeepSeek Anthropic 兼容端点的路由模型
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-flash

# 可选：配置后删除 App 时会尽力清理 COS 封面
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
