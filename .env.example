# MySQL 使用与原项目一致的表结构
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/aicode?charset=utf8mb4

# Redis 保存服务端 Session
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=3600

# 后端监听地址、端口与日志级别（`uv run ai-code-py` / `python -m app.main` 使用）
SERVER_HOST=127.0.0.1
SERVER_PORT=8123
LOG_LEVEL=info
AGENT_DEBUG_LOG_ENABLED=false
AGENT_DEBUG_LOG_MAX_CHARS=100000

# 前端开发地址
CORS_ORIGINS=["http://localhost:5173"]

# 生产环境应开启 Secure Cookie
SESSION_COOKIE_SECURE=false

# 对外部署地址前缀，必须能路由到 /api/deploy 静态挂载
# 封面截图使用服务器内部地址，避免 Chrome 访问自身公网 IP 失败
# COVER_SCREENSHOT_URL_BASE=http://127.0.0.1:8123/api/deploy
DEPLOY_URL_BASE=http://localhost:8123/api/deploy

# DeepSeek Anthropic 兼容端点的路由模型
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-flash
MODEL_CONTEXT_WINDOW_TOKENS=128000
CONTEXT_COMPACTION_TRIGGER_RATIO=0.8
CONTEXT_COMPACTION_SUMMARY_MAX_TOKENS=2000
CONTEXT_COMPACTION_FIXED_OVERHEAD_TOKENS=2000
AGENT_MAX_ROUNDS_PER_PHASE=12
AGENT_MAX_VALIDATION_REPAIRS=3
GENERATION_EVENT_BUFFER_LIMIT=16384
GENERATION_FINISHED_TURN_TTL_SECONDS=600
GENERATION_TURN_RECEIPT_LIMIT=10
GENERATION_AGENT_IDLE_TTL_SECONDS=1800
VUE_BROWSER_VALIDATION_ENABLED=true
VUE_BROWSER_VALIDATION_TIMEOUT_SECONDS=30
VUE_BROWSER_VALIDATION_WAIT_SECONDS=1
VUE_BROWSER_VALIDATION_MIN_CSS_BYTES=200

# 可选：配置后删除 App 时会尽力清理 COS 封面
COS_PUBLIC_BASE_URL=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=

# Selenium 默认只使用本机 Chrome/ChromeDriver，禁止联网自动下载
SELENIUM_OFFLINE=true
# 按服务器实际安装位置填写；留空时仅从本地缓存或 PATH 查找
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# CHROME_BINARY_PATH=/usr/bin/google-chrome

# 部署后异步截图
SCREENSHOT_TIMEOUT_SECONDS=30
SCREENSHOT_WAIT_AFTER_LOAD_SECONDS=1
COVER_SHUTDOWN_TIMEOUT_SECONDS=10

# M2 应用级持久记忆，默认关闭
APP_MEMORY_ENABLED=false
APP_MEMORY_MAX_CHARS=4000

# M2 一级有界子代理，默认关闭
SUBAGENT_ENABLED=false
SUBAGENT_MAX_ROUNDS=6
SUBAGENT_TIMEOUT_SECONDS=60
